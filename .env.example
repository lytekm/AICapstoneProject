# LLM backend configuration
# Set USE_MOCK_LLM=0 to route abstractive/hybrid requests through a real LLM
USE_MOCK_LLM=1
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Prometheus cluster (Talos k8s) -- use this when on the home network
# VLLM_BASE_URL=http://192.168.2.205:8000/v1

# RSS feed source for article fetching
RSS_FEED_URL=https://www.cbc.ca/cmlink/rss-business
